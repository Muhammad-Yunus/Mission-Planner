# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Connection (Separated Parameters)
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=

# Google Maps Platform JavaScript API Key (restrict to HTTP referrers in production)
VITE_GOOGLE_MAPS_API_KEY=

# Optional static External Ingest API Key for headless telemetry scripts (in addition to DB-managed keys)
INGEST_API_KEY=
